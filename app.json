{
  "expo": {
    "name": "Ninho",
    "slug": "ninho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ninho-logo.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ninho",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ninho.family"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E",
        "foregroundImage": "./assets/ninho-logo.png"
      },
      "package": "app.ninho.family",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/ninho-logo.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/ninho-logo.png",
          "color": "#E8760A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Ninho precisa acessar suas fotos para adicionar foto do bebê.",
          "cameraPermission": "O Ninho precisa acessar a câmera para tirar foto do bebê."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "router": {
      "root": "src/app"
    },
    "extra": {
      "eas": {
        "projectId": "a26a938d-adf9-4716-bd4e-cf03f76d98ac"
      }
    },
    "owner": "artur.santana"
  }
}
